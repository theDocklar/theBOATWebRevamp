# Copy to .env.local and fill in your values.
#
# Gmail setup:
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use that 16-character password (spaces optional) for GMAIL_APP_PASSWORD

GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
CONTACT_TO_EMAIL=info@theboatgrp.com

# Sanity Setup
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Google Analytics 4 (GA4) Tracking
# Find in GA4: Admin > Data Streams > Web > Measurement ID (starts with G-)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Google Search Console / Webmaster Verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_token

# Google Analytics Data API (For Pulling Real-Time & Historical Data)
# 1. Numeric GA4 Property ID (Admin > Property Settings in Google Analytics)
GA4_PROPERTY_ID=123456789

# 2. Google Cloud Service Account credentials with "Viewer" role in GA4 Property Access
GOOGLE_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"